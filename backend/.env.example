# OpsPilot API — copy to .env and adjust locally.
# Do not put secrets in source control.

APP_NAME=opspilot-api
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Comma-separated origins for the local Vite frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/opspilot
REDIS_URL=redis://localhost:6379/0
