# OpsPilot Environment Configuration Template

APP_NAME=opspilot-api
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=opspilot-secure-secret-key-2026-demo
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database & Redis Connection Settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/opspilot
REDIS_URL=redis://localhost:6379/0

# AI Provider Settings
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_PROVIDER=anthropic

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8000
